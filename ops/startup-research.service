[Unit]
Description=VentureLens BP Review
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__SERVICE_USER__
Group=__SERVICE_GROUP__
WorkingDirectory=__REMOTE_DIR__
Environment=NODE_ENV=production
EnvironmentFile=__REMOTE_DIR__/.env
ExecStart=/usr/bin/node __REMOTE_DIR__/server.mjs
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=full
ReadWritePaths=__REMOTE_DIR__/data

[Install]
WantedBy=multi-user.target
